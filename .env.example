# Required: your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional: Claude model used for every step (default: claude-opus-5)
# MARKETME_MODEL=claude-opus-5

# Optional: where the JSON datastore lives (default: ./.data)
# MARKETME_DATA_DIR=.data

# Optional but strongly recommended when deployed: protects the whole app
# (and your API credits) with HTTP Basic auth. Username is "admin".
# MARKETME_PASSWORD=
