# Required: your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional: Claude model used for every step (default: claude-opus-5)
# MARKETME_MODEL=claude-opus-5

# Optional: where the JSON datastore lives (default: ./.data)
# MARKETME_DATA_DIR=.data

# Who can create an account. Every account spends your Claude credits, so by
# default only the first account (yours) can sign up. To let others in, either
# list their emails (use *@domain.com for a whole domain)...
# MARKETME_ALLOWED_EMAILS=teammate@example.com,*@yourcompany.com
# ...or open sign-ups to anyone:
# MARKETME_SIGNUPS=open
